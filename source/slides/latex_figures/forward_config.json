    "damage_tol": 1e-08,
    "damage_max_iter": 1000,
    "stagger_tol": 1e-05,
    "max_stagger": 200,
    "fail_on_mechanics_nonconvergence": true,
    "fail_on_stagger_nonconvergence": true
  },
  "limits": {
    "solver_seconds_target_low": 60,
    "solver_seconds_target_high": 120,
    "solver_seconds_hard": 300,
